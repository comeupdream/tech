# Discord Bot Token — create for free at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Path to a reference audio clip of the person to clone (~10-30s of clean speech)
# Default: audio_samples/reference.wav
# REFERENCE_AUDIO=audio_samples/reference.wav

# --- Optional tuning (defaults work fine) ---

# Whisper model size: tiny, base, small, medium, large-v3
# WHISPER_MODEL=base

# Whisper device: auto, cuda, cpu
# WHISPER_DEVICE=auto

# Ollama base URL (default: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama model (run: ollama pull llama3.1)
# OLLAMA_MODEL=llama3.1

# Chatterbox voice expressiveness (0.0 - 1.0)
# CHATTERBOX_EXAGGERATION=0.6
