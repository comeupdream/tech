# Discord Bot Token — create at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Deepgram API Key — get free at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key — for the LLM brain
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key — for TTS + voice cloning
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs cloned voice ID (created after uploading samples)
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
