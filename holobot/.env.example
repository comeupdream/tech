# All settings are optional — defaults work out of the box.
# Just place a reference.wav in audio_samples/ and run: python bot.py

# Path to reference audio clip (~10-30s of the target speaking)
# REFERENCE_AUDIO=audio_samples/reference.wav

# Whisper model size: tiny, base, small, medium, large-v3
# WHISPER_MODEL=base

# LLM model (HuggingFace GGUF repo + filename)
# LLM_REPO_ID=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
# LLM_MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf

# GPU layers for LLM: -1 = all GPU, 0 = CPU only
# LLM_GPU_LAYERS=-1

# Chatterbox voice expressiveness (0.0 - 1.0)
# CHATTERBOX_EXAGGERATION=0.6
